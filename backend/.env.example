FLASK_APP=run.py
FLASK_ENV=development
# Dev-only secrets (32+ chars, matching config.py minimums).
# PRODUCTION: generate fresh random values, never reuse these.
SECRET_KEY=dev-only-secret-key-32-chars-minimum!
DATABASE_URL=sqlite:///secsim.db
JWT_SECRET_KEY=dev-only-jwt-secret-key-32-chars-min!
# Login token lifetime in hours (default 12 when unset)
JWT_ACCESS_HOURS=12
# Rate-limit counter storage: memory:// for single-process dev,
# redis://localhost:6379 for multi-worker production
RATELIMIT_URL=memory://
# Global safety net for all /api/* routes (auth routes are stricter)
RATELIMIT_DEFAULT=200 per minute
